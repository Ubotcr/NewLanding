---
import { Image } from "astro:assets";
import ubitBooks from "@/assets/ubit-books.webp";
import SectionHeader from "@/components/SectionHeader.astro";
import { estandarizadas, mathFeatures } from "@/config/preparation";
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---

<section class="px-4 py-12 md:py-20">
  <div class="container mx-auto max-w-5xl">
    <SectionHeader
      title="Matemáticas para las Estandarizadas"
      subtitle="Un piloto para secundaria académica diurna, con práctica y apoyo para repasar lo que aprendes en clase."
    />
    <div class="grid items-center gap-8 md:grid-cols-[0.7fr_1fr] md:gap-12">
      <Image
        src={ubitBooks}
        alt=""
        width={320}
        loading="lazy"
        decoding="async"
        class="mx-auto h-auto w-36 md:w-56"
      />
      <div>
        <ul class="space-y-5">
          {
            mathFeatures.map((feature) => (
              <li>
                <>
                  <h3 class="text-lg font-semibold text-text-light">
                    {feature.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-text">
                    {feature.description}
                  </p>
                </>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-sm text-gray">
          Las actividades, preguntas y materiales dependen del catálogo
          disponible.
        </p>
        <a
          class="btn btn-primary mt-6"
          href={detailed ? estandarizadas.app : estandarizadas.page}
          >{
            detailed
              ? estandarizadas.entryLabel
              : "Conoce el piloto de Matemáticas"
          }</a
        >
      </div>
    </div>
  </div>
</section>
