---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import { getListPage } from "@/lib/contentParser";
import { getFullCalendarEvents } from "@/lib/api/events";
import {
  sortByStart,
  formatEventDate,
  groupByMonth,
  calendarStatusBadge,
  calendarStateClasses,
  CATEGORY_LABELS,
  CATEGORY_CLASSES,
} from "@/lib/utils/calendar";

const universities = ["UCR", "UNA", "TEC"] as const;
const categories = Object.keys(
  CATEGORY_LABELS,
) as (keyof typeof CATEGORY_LABELS)[];

const callToAction = await getListPage("sections/call-to-action.md");
const calendarEvents = await getFullCalendarEvents();

const sorted = sortByStart(calendarEvents);
const groups = groupByMonth(sorted);
---

<Base
  title="Calendario de admisión 2026"
  description="Todas las fechas clave de admisión universitaria en Costa Rica (UCR, UNA, TEC) en un solo lugar."
>
  <section class="px-4 py-12 md:py-16">
    <div class="container mx-auto max-w-3xl">
      <div class="text-center">
        <h1 class="text-3xl font-extrabold text-text-light md:text-4xl">
          Calendario de admisión 2026
        </h1>
        <p class="mx-auto mt-3 max-w-2xl text-text">
          Todas las fechas de inscripción, exámenes, becas y ferias de la UCR,
          la UNA y el TEC en un solo lugar. Verificá siempre las fechas en las
          fuentes oficiales.
        </p>
      </div>

      <aside class="mt-6 rounded-xl border border-border bg-card p-4 text-text-light" aria-label="Aviso sobre las fechas">
        <p class="font-semibold">Confirmá las fechas antes de realizar un trámite</p>
        <p class="mt-2 text-sm">
          Este calendario es orientativo y puede incluir fechas aproximadas o cambios pendientes de actualización.
          Antes de inscribirte, presentar una prueba o matricular, consultá la convocatoria y las fuentes oficiales de
          <a class="underline" href="https://ori.ucr.ac.cr/inicio/estudiantes/admision">UCR</a>,
          <a class="underline" href="https://www.registro.una.ac.cr/">UNA</a> y
          <a class="underline" href="https://www.tec.ac.cr/calendario-admision">TEC</a>.
        </p>
      </aside>

      {/* Filtros */}
      <div class="mt-8 flex flex-col gap-3" data-calendar-filters>
        <div class="flex flex-wrap items-center gap-2">
          <span class="mr-1 text-sm font-semibold text-gray">Universidad:</span>
          <button
            class="rounded-full border border-primary bg-primary px-3 py-1 text-sm font-semibold text-white"
            data-filter-uni="all">Todas</button
          >
          {
            universities.map((u) => (
              <button
                class="rounded-full border border-border px-3 py-1 text-sm font-semibold text-text"
                data-filter-uni={u}
              >
                {u}
              </button>
            ))
          }
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="mr-1 text-sm font-semibold text-gray">Tipo:</span>
          <button
            class="rounded-full border border-primary bg-primary px-3 py-1 text-sm font-semibold text-white"
            data-filter-cat="all">Todas</button
          >
          {
            categories.map((c) => (
              <button
                class="rounded-full border border-border px-3 py-1 text-sm font-semibold text-text"
                data-filter-cat={c}
              >
                {CATEGORY_LABELS[c]}
              </button>
            ))
          }
        </div>
      </div>

      {/* Timeline */}
      <div class="mt-10 flex flex-col gap-10" data-calendar-timeline>
        {
          groups.map((g) => (
            <div data-month-group data-month={g.key}>
              <h2 class="mb-4 text-lg font-bold capitalize text-text-light">
                {g.label}
              </h2>
              <div class="flex flex-col gap-4">
                {g.events.map((ev) => {
                  const badge = calendarStatusBadge(ev);
                  const stateClasses = calendarStateClasses(ev);
                  return (
                    <article
                      id={ev.id}
                      class={`rounded-xl border border-border bg-card p-5 transition-opacity ${stateClasses.join(" ")}`}
                      data-event
                      data-universities={ev.universities.join(",")}
                      data-category={ev.category}
                    >
                      <div class="flex flex-wrap items-center gap-2">
                        <span
                          class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${CATEGORY_CLASSES[ev.category]}`}
                        >
                          {CATEGORY_LABELS[ev.category]}
                        </span>
                        {ev.universities.map((u) => (
                          <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary">
                            {u}
                          </span>
                        ))}
                        {badge && (
                          <span
                            class={`ml-auto rounded-full px-2.5 py-0.5 text-xs font-semibold ${badge.cls}`}
                          >
                            {badge.label}
                          </span>
                        )}
                      </div>
                      <p class="mt-3 text-sm font-semibold text-gray">
                        {formatEventDate(ev)}
                      </p>
                      <h3 class="mt-1 text-lg font-bold text-text-light">
                        {ev.title}
                      </h3>
                      {ev.description && (
                        <p class="mt-1 text-sm text-text">{ev.description}</p>
                      )}
                      {ev.link && (
                        <a
                          href={ev.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="mt-3 inline-block text-sm font-semibold text-primary hover:underline"
                        >
                          Fuente oficial →
                        </a>
                      )}
                    </article>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-10 hidden text-center text-text" data-calendar-empty>
        No hay eventos con esos filtros.
      </p>

      <div class="mx-auto mt-12 max-w-3xl text-left text-sm text-text">
        <h2 class="text-lg font-semibold text-text-light">
          Cómo mantenemos estas fechas
        </h2>
        <p class="mt-2">
          Actualizado en octubre 2026 por Eddie Bermúdez, Desarrollador del
          Frontend & Landing. Revisamos el calendario cada semana contra las
          fuentes oficiales: <a class="text-primary hover:underline" href="https://admision.ac.cr">admision.ac.cr</a>,
          UCR, UNA y TEC. Si una fecha cambia, la corregimos y la verás aquí
          sin reinstalar nada.
        </p>
        <p class="mt-2">
          Cada tarjeta trae su enlace a la fuente oficial para que verifiques
          antes de inscribirte. ¿Ves una fecha desactualizada? Escríbenos a
          contacto@ubotcr.com y la revisamos en 1-2 días hábiles.
        </p>
        <p class="mt-2">
          Para prepararte, mide tu nivel con el
          <a class="text-primary hover:underline" href="/blog/examen-diagnostico-admision-gratis">diagnóstico gratuito</a>
          y sigue las <a class="text-primary hover:underline" href="/blog/como-prepararse-paa">guías PAA</a>.
        </p>
      </div>
    </div>
  </section>

  <CallToAction data={callToAction} />
</Base>

<script>
  import { fetchFullCalendarClient } from "@/lib/api/events-client";
  import {
    formatEventDate,
    groupByMonth,
    sortByStart,
    calendarStatusBadge,
    calendarStateClasses,
    CATEGORY_LABELS,
    CATEGORY_CLASSES,
  } from "@/lib/utils/calendar";
  import type { CalendarEvent } from "@/config/calendar";

  const timeline = document.querySelector<HTMLElement>(
    "[data-calendar-timeline]",
  );

  function renderTimeline(fresh: CalendarEvent[]) {
    if (!timeline) return;
    const groups = groupByMonth(sortByStart(fresh));

    timeline.innerHTML = "";
    for (const g of groups) {
      const groupEl = document.createElement("div");
      groupEl.dataset.monthGroup = "";
      groupEl.dataset.month = g.key;

      const h2 = document.createElement("h2");
      h2.className = "mb-4 text-lg font-bold capitalize text-text-light";
      h2.textContent = g.label;
      groupEl.appendChild(h2);

      const list = document.createElement("div");
      list.className = "flex flex-col gap-4";

      for (const ev of g.events) {
        const stateClasses = calendarStateClasses(ev);
        const badge = calendarStatusBadge(ev);

        const article = document.createElement("article");
        article.id = ev.id;
        article.className =
          `rounded-xl border border-border bg-card p-5 transition-opacity ${stateClasses.join(" ")}`.trim();
        article.dataset.event = "";
        article.dataset.universities = ev.universities.join(",");
        article.dataset.category = ev.category;

        const badges = document.createElement("div");
        badges.className = "flex flex-wrap items-center gap-2";

        const catBadge = document.createElement("span");
        catBadge.className = `rounded-full px-2.5 py-0.5 text-xs font-semibold ${CATEGORY_CLASSES[ev.category]}`;
        catBadge.textContent = CATEGORY_LABELS[ev.category];
        badges.appendChild(catBadge);

        for (const u of ev.universities) {
          const uniBadge = document.createElement("span");
          uniBadge.className =
            "rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary";
          uniBadge.textContent = u;
          badges.appendChild(uniBadge);
        }

        if (badge) {
          const stateBadge = document.createElement("span");
          stateBadge.className = `ml-auto rounded-full px-2.5 py-0.5 text-xs font-semibold ${badge.cls}`;
          stateBadge.textContent = badge.label;
          badges.appendChild(stateBadge);
        }

        article.appendChild(badges);

        const date = document.createElement("p");
        date.className = "mt-3 text-sm font-semibold text-gray";
        date.textContent = formatEventDate(ev);
        article.appendChild(date);

        const title = document.createElement("h3");
        title.className = "mt-1 text-lg font-bold text-text-light";
        title.textContent = ev.title;
        article.appendChild(title);

        if (ev.description) {
          const desc = document.createElement("p");
          desc.className = "mt-1 text-sm text-text";
          desc.textContent = ev.description;
          article.appendChild(desc);
        }

        if (ev.link) {
          const link = document.createElement("a");
          link.href = ev.link;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          link.className =
            "mt-3 inline-block text-sm font-semibold text-primary hover:underline";
          link.textContent = "Fuente oficial →";
          article.appendChild(link);
        }

        list.appendChild(article);
      }

      groupEl.appendChild(list);
      timeline.appendChild(groupEl);
    }

    events.length = 0;
    events.push(
      ...Array.from(document.querySelectorAll<HTMLElement>("[data-event]")),
    );
    apply();
  }

  let events = Array.from(
    document.querySelectorAll<HTMLElement>("[data-event]"),
  );

  // --- Filtros universidad + categoría (AND) ---
  let uni = "all";
  let cat = "all";

  const apply = () => {
    let visible = 0;
    for (const el of events) {
      const unis = (el.dataset.universities || "").split(",");
      const okUni = uni === "all" || unis.includes(uni);
      const okCat = cat === "all" || el.dataset.category === cat;
      const show = okUni && okCat;
      el.classList.toggle("hidden", !show);
      if (show) visible++;
    }
    // Ocultar grupos de mes vacíos.
    document
      .querySelectorAll<HTMLElement>("[data-month-group]")
      .forEach((g) => {
        const anyVisible = g.querySelector("[data-event]:not(.hidden)");
        g.classList.toggle("hidden", !anyVisible);
      });
    document
      .querySelector<HTMLElement>("[data-calendar-empty]")
      ?.classList.toggle("hidden", visible > 0);
  };

  const wire = (attr: string, setter: (v: string) => void) => {
    document.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((btn) => {
      btn.addEventListener("click", () => {
        const group = document.querySelectorAll<HTMLElement>(`[${attr}]`);
        group.forEach((b) => {
          b.classList.remove("border-primary", "bg-primary", "text-white");
          b.classList.add("border-border", "text-text");
        });
        btn.classList.add("border-primary", "bg-primary", "text-white");
        btn.classList.remove("border-border", "text-text");
        setter(btn.getAttribute(attr) || "all");
        apply();
      });
    });
  };

  wire("data-filter-uni", (v) => (uni = v));
  wire("data-filter-cat", (v) => (cat = v));

  apply();

  // Carga dinámica en navegador: si el backend responde, reemplaza el
  // timeline estático con datos frescos (conserva los filtros activos).
  // Si falla, se queda el HTML estático ya pintado (SSG, build-time).
  fetchFullCalendarClient().then((fresh) => {
    if (fresh) renderTimeline(fresh);
  });
</script>
