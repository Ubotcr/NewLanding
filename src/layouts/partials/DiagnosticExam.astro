---
import Icon from "@/components/Icon.astro";
import { Image } from "astro:assets";
import ubitBooks from "@/assets/ubit-books.webp";

interface Props {
  data: any;
  id?: string;
  compact?: boolean;
}

const { data, id = "diagnostico", compact = false } = Astro.props;
const { badge, title, description, button, enable } = data.frontmatter;
---

{
  enable && (
    <section
      id={id}
      class:list={[
        "px-4 py-12 md:py-16",
        compact ? "bg-body" : "border-y border-border bg-card",
      ]}
    >
      <div class="container relative mx-auto max-w-3xl">
        {!compact && (
          <Image
            src={ubitBooks}
            alt=""
            aria-hidden="true"
            widths={[160, 320]}
            sizes="(min-width: 768px) 144px, 96px"
            width={320}
            loading="lazy"
            decoding="async"
            class="diagnostic-card__ubit pointer-events-none relative z-20 mx-auto -mb-8 block h-auto w-24 select-none md:-mb-12 md:w-36"
          />
        )}

        <div class="diagnostic-card relative z-10 rounded-2xl border border-border bg-ink-raised px-6 py-12 text-center shadow-xl md:px-12 md:py-16">
          {badge && (
            <span class="inline-flex rounded-full bg-secondary px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
              {badge}
            </span>
          )}
          <h2
            class="mt-4 font-bold text-text-light"
            style="font-size: clamp(1.875rem, 4vw, 2.25rem); text-wrap: balance;"
          >
            {title}
          </h2>
          <p class="mx-auto mt-4 max-w-[60ch] text-text">{description}</p>
          {button?.enable && (
            <a
              href={button.link}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-lg mt-8 inline-flex min-h-[44px]"
            >
              <Icon name="quiz" class="text-lg" filled />
              {button.label}
            </a>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .diagnostic-card__ubit {
    animation: diagnostic-card-ubit-arrive 450ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes diagnostic-card-ubit-arrive {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .diagnostic-card__ubit {
      animation: none;
    }
  }
</style>

