{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishLandingObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::ubot-landing-537528034060/*"
    },
    {
      "Sid": "InvalidateLandingDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::537528034060:distribution/E2BKWM9LMK1B99"
    }
  ]
}
