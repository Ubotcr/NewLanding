---
import { markdownify } from "@/lib/utils/textConverter";

interface Props {
  page_header: any;
}

const { page_header } = Astro.props;
const { title, subtitle, button_primary, button_secondary } = page_header || {};
---

{
  title && (
    <section class="border-b border-border px-4 pb-16 pt-10 text-center md:pt-14">
      <div class="container mx-auto max-w-3xl">
        <h1
          class="mt-4 font-extrabold text-text-light"
          style="font-size: clamp(2.25rem, 6vw, 3.75rem); text-wrap: balance;"
          set:html={markdownify(title).__html}
        />
        {subtitle && <p class="mx-auto mt-4 max-w-xl text-text">{subtitle}</p>}
        {(button_primary?.enable || button_secondary?.enable) && (
          <div class="mt-7 flex flex-wrap justify-center gap-4">
            {button_primary?.enable && (
              <a href={button_primary.link} class="btn btn-primary btn-lg">
                {button_primary.label}
              </a>
            )}
            {button_secondary?.enable && (
              <a href={button_secondary.link} class="btn btn-outline btn-lg">
                {button_secondary.label}
              </a>
            )}
          </div>
        )}
      </div>
    </section>
  )
}
