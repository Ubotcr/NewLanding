---
import Base from "@/layouts/Base.astro";
import PostSingle from "@/layouts/PostSingle.astro";
import { getCollection } from "astro:content";
import config from "@/config/config.json";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { isoDate } from "@/lib/utils/blog";

export async function getStaticPaths() {
  const posts = await getCollection(
    "blog",
    ({ id, data }) => !id.startsWith("-") && !id.startsWith("_") && !data.draft,
  );
  return posts.map((post) => ({
    params: { single: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, meta_title, description, image, date, updated, author } = post.data;

const canonicalUrl = `${config.site.base_url}/blog/${post.id}`;
const published = date ? isoDate(date) : undefined;
const modified = updated ? isoDate(updated) : published;
const breadcrumbs = [{ name: "Inicio", path: "/" }, { name: "Blog", path: "/blog" }, { name: title, path: `/blog/${post.id}` }];
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": image ? `${config.site.base_url}${image}` : `${config.site.base_url}${config.metadata.meta_image}`,
  "author": {
    "@type": "Person",
    "name": author?.name || config.metadata.meta_author,
    ...(author?.designation ? { "jobTitle": author.designation } : {}),
    "url": `${config.site.base_url}/about`
  },
  "datePublished": published,
  "dateModified": modified,
  "mainEntityOfPage": canonicalUrl,
  "publisher": {
    "@type": "Organization",
    "name": config.site.title,
    "logo": {
      "@type": "ImageObject",
      "url": `${config.site.base_url}${config.site.logo_icon}`
    }
  }
};
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  canonical={canonicalUrl}
  ogType="article"
  structuredData={[articleSchema]}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    {(author?.name || config.metadata.meta_author) && (
      <meta property="article:author" content={author?.name || config.metadata.meta_author} />
    )}
  </Fragment>
  <Breadcrumbs items={breadcrumbs} />
  <PostSingle post={post} />
</Base>
