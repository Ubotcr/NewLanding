---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('practices')).map(({data}) => ({params:{product:data.product,slug:data.slug},props:{unit:data}})); }
const { unit } = Astro.props;
---
<Base title={unit.title} description={unit.intro}>
<main class="container content mx-auto max-w-3xl px-4 py-12"><a href={`/${unit.product}/practica`}>Volver a las prácticas</a><h1>{unit.title}</h1><p>Material original de Ubot · Versión inicial, pendiente de revisión humana.</p><p>{unit.intro}</p><h2>Ejemplos resueltos</h2><p>{unit.example}</p>
<form data-practice class="quiz">
  <h2>Probá lo aprendido</h2>
  <div data-progress hidden><p data-counter aria-live="polite"></p><progress value="0" max={unit.questions.length} aria-label="Preguntas completadas"></progress></div>
  {unit.questions.map((q, index) => <fieldset class="question-card" data-question>
    <legend tabindex="-1">{index + 1}. {q.prompt}</legend>
    <div class="choices">{[...q.options.slice(index % q.options.length), ...q.options.slice(0,index % q.options.length)].map(o => <label class="choice"><input type="radio" name={q.id} value={o.id} data-correct={String(o.id === q.answer)} /> <span>{o.text}</span></label>)}</div>
    <p data-feedback role="status" tabindex="-1" hidden></p>
    <details><summary>Solución y explicación de alternativas</summary>{q.options.map(o => <p><strong>{o.text}{o.id === q.answer ? ' (correcta)' : ''}:</strong> {o.explanation}</p>)}</details>
  </fieldset>)}
  <div class="quiz-actions"><button type="submit" class="btn btn-primary" data-check hidden>Comprobar respuesta</button><button type="button" class="btn btn-primary" data-next hidden>Siguiente pregunta →</button><button type="reset" class="btn btn-primary" data-restart hidden>Volver a empezar</button></div>
  <p role="status" aria-live="polite" data-result tabindex="-1"></p>
  <noscript><p>Podés resolver las preguntas y abrir sus soluciones para comprobar tus respuestas.</p></noscript>
</form>
<p>Revisá las explicaciones de los ejercicios que fallaste y repetí el planteamiento antes de reiniciar.</p><p><a href={`https://${unit.product === 'admision' ? 'chat' : 'estandarizadas'}.ubotcr.com`}>Seguí practicando en la app</a></p><p>Preparación independiente: no es una prueba oficial ni predice un resultado de admisión o del MEP. <a href="/contact">Reportá un error</a>.</p></main>
</Base>
<script>
 document.querySelectorAll<HTMLFormElement>('[data-practice]').forEach(form => {
  const fields = [...form.querySelectorAll<HTMLFieldSetElement>('[data-question]')];
  const result = form.querySelector<HTMLElement>('[data-result]')!;
  const counter = form.querySelector<HTMLElement>('[data-counter]')!;
  const progress = form.querySelector<HTMLProgressElement>('progress')!;
  const check = form.querySelector<HTMLButtonElement>('[data-check]')!;
  const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
  const restart = form.querySelector<HTMLButtonElement>('[data-restart]')!;
  // Focus without the browser's implicit jump; scroll after layout settles.
  function focusContent(target: HTMLElement, alignTop = false) {
    target.focus({ preventScroll: true });
    requestAnimationFrame(() => {
      const header = document.querySelector('header');
      const offset = (header?.getBoundingClientRect().height ?? 0) + 20;
      const rect = target.getBoundingClientRect();
      if (alignTop || rect.top < offset || rect.bottom > window.innerHeight - 24) {
        window.scrollTo({
          top: Math.max(0, window.scrollY + rect.top - offset),
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
        });
      }
    });
  }
  let current = 0;
  let score = 0;
  let checked = false;
  form.querySelector<HTMLElement>('[data-progress]')!.hidden = false;
  function show(focus = false) {
    fields.forEach((field, i) => field.hidden = i !== current);
    counter.textContent = `Pregunta ${current + 1} de ${fields.length}`;
    check.hidden = false;
    next.hidden = true;
    restart.hidden = true;
    checked = false;
    if (focus) focusContent(fields[current].querySelector('legend')!, true);
  }
  show();
  form.addEventListener('submit', event => {
    event.preventDefault();
    if (checked || current >= fields.length) return;
    const field = fields[current];
    const selected = field.querySelector<HTMLInputElement>('input:checked');
    if (!selected) {
      result.textContent = 'Elegí una respuesta antes de comprobar.';
      focusContent(field.querySelector<HTMLInputElement>('input')!);
      return;
    }
    result.textContent = '';
    const correct = selected.dataset.correct === 'true';
    if (correct) score++;
    checked = true;
    const feedback = field.querySelector<HTMLElement>('[data-feedback]')!;
    feedback.textContent = correct ? '¡Correcto! Revisá la explicación para reforzar lo aprendido.' : 'Esta vez no. Revisá la solución antes de seguir.';
    feedback.hidden = false;
    field.dataset.outcome = correct ? 'correct' : 'incorrect';
    field.querySelectorAll<HTMLInputElement>('input').forEach(input => input.disabled = true);
    field.querySelector('details')!.open = true;
    progress.value = current + 1;
    check.hidden = true;
    next.hidden = false;
    next.textContent = current === fields.length - 1 ? 'Ver mi resultado' : 'Siguiente pregunta →';
    focusContent(feedback);
  });
  next.addEventListener('click', () => {
    if (!checked) return;
    current++;
    if (current < fields.length) { show(true); return; }
    next.hidden = true;
    restart.hidden = false;
    counter.textContent = 'Práctica completada';
    result.textContent = `${score} de ${fields.length} correctas. Podés repasar tus respuestas y sus explicaciones en las tarjetas.`;
    fields.forEach(field => { field.hidden = false; field.querySelector('details')!.open = false; });
    focusContent(result, true);
  });
  form.addEventListener('reset', () => {
    current = 0; score = 0; progress.value = 0; result.textContent = '';
    fields.forEach(field => {
      delete field.dataset.outcome;
      field.querySelectorAll<HTMLInputElement>('input').forEach(input => input.disabled = false);
      field.querySelector('details')!.open = false;
      field.querySelector<HTMLElement>('[data-feedback]')!.hidden = true;
    });
    show(true);
  });
 });
</script>

<style>
  .quiz [hidden] { display: none !important; }
  .quiz { margin-block: 2rem; width: 100%; min-width: 0; overflow-wrap: anywhere; }
  .quiz progress { width: 100%; height: .5rem; accent-color: #4497db; margin-bottom: 1.5rem; }
  .quiz [data-counter] { font-weight: 600; color: #f8fafc; }
  .question-card { box-sizing: border-box; width: 100%; max-width: 100%; min-width: 0; margin: 1rem 0 1.5rem; padding: 1.5rem; border: 1px solid #2a2f3d; border-radius: 1rem; background: #1a1d27; }
  .question-card legend { box-sizing: border-box; float: left; width: 100%; min-width: 0; max-width: 100%; white-space: normal; padding: .25rem .5rem; font-size: 1.15rem; font-weight: 600; }
  .choices { clear: both; display: grid; grid-template-columns: minmax(0, 1fr); min-width: 0; gap: .75rem; margin-block: 1rem; }
  .choice { min-width: 0; max-width: 100%; box-sizing: border-box; display: flex; align-items: baseline; gap: .75rem; padding: 1rem; border: 1px solid #64748b; border-radius: .75rem; cursor: pointer; background: #141925; }
  .choice:has(input:checked) { border-color: #4497db; background: #19334d; }
  .choice:has(input:focus-visible) { outline: 2px solid #f8fafc; outline-offset: 3px; }
  .choice span { min-width: 0; overflow-wrap: anywhere; }
  .quiz-actions button { min-width: 0; max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
  .quiz details { min-width: 0; }
  .choice input { flex-shrink: 0; accent-color: #4497db; }
  .question-card[data-outcome="correct"] { border-color: #4ade80; }
  .question-card[data-outcome="incorrect"] { border-color: #fbbf24; }
  .quiz-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .quiz fieldset, .quiz legend, .quiz label, .quiz summary, .quiz p, .quiz strong { color: var(--color-text-light, #f8fafc); }
  .quiz summary { cursor: pointer; }
  .quiz legend:focus-visible, .quiz [data-feedback]:focus-visible, .quiz [data-result]:focus-visible {
    outline: 2px solid #4497db;
    outline-offset: 5px;
    border-radius: .25rem;
  }
  @media (max-width: 480px) { .question-card { padding: 1rem; } .quiz-actions button { width: 100%; } }
</style>
