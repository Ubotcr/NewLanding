---
import { markdownify } from "@/lib/utils/textConverter";
import Icon from "@/components/Icon.astro";
import UbitRig from "@/components/UbitRig.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import logoUCR from "../../../public/images/logos/UCR.png";
import logoUNA from "../../../public/images/logos/UNA.svg";
import logoTEC from "../../../public/images/logos/TEC.svg";

interface Props {
  data: any;
}

const { data } = Astro.props;
const logos = [
  { src: logoUCR, alt: "Universidad de Costa Rica" },
  { src: logoUNA, alt: "Universidad Nacional de Costa Rica" },
  { src: logoTEC, alt: "Tecnológico de Costa Rica" },
];
// Los logos se muestran a 96-112px; con padding (p-4) el espacio real es 64-80px.
// 160px cubre retina (2x80px). SVG se mantienen vectoriales.
const logoWidth = (meta: ImageMetadata) =>
  meta.format === "svg" ? undefined : 160;
---

<section class="relative grid min-h-[calc(100svh-4rem)] grid-rows-[1fr_auto] items-center gap-y-4 overflow-hidden px-4 pb-4 pt-12">
  <div class="container relative z-10 mx-auto grid w-full max-w-6xl items-center gap-8 self-center lg:grid-cols-[1.05fr_0.95fr] lg:gap-6">
    <div class="text-center lg:text-left">
      <div class="mb-6">
        <div class="flex flex-wrap items-center justify-center gap-2 min-[420px]:gap-3 md:gap-4 lg:justify-start">
          {
            logos.map((logo) => (
              <div
                class="flex h-16 w-16 items-center justify-center rounded-2xl border border-border bg-light p-3 shadow-sm transition-transform hover:-translate-y-1 min-[420px]:h-20 min-[420px]:w-20 min-[420px]:p-4 md:h-24 md:w-24"
                title={logo.alt}
              >
                <Image
                  src={logo.src}
                  alt={logo.alt}
                  width={logoWidth(logo.src)}
                  class="h-full w-full object-contain"
                  loading="eager"
                />
              </div>
            ))
          }
          <div class="flex h-20 w-14 shrink-0 items-center justify-center min-[420px]:hidden">
            <UbitRig loading="eager" />
          </div>
        </div>
      </div>

      <h1
        class="mx-auto max-w-3xl font-extrabold leading-tight text-text-light lg:mx-0"
        style="font-size: clamp(2rem, 5vw, 3.5rem); text-wrap: balance;"
        set:html={markdownify(data.title).__html}
      />

      <p
        class="mx-auto mt-5 max-w-xl text-lg text-text lg:mx-0"
        style="text-wrap: pretty;"
      >
        {data.content}
      </p>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-4 lg:justify-start">
        {
          data.button_primary?.enable && (
            <a
              href={data.button_primary.link}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-lg"
            >
              <Icon name="sports_esports" class="text-lg" filled />
              {data.button_primary.label}
            </a>
          )
        }
        {
          data.button_secondary?.enable && (
            <a href={data.button_secondary.link} class="btn btn-outline btn-lg">
              {data.button_secondary.label}
            </a>
          )
        }
      </div>
    </div>

    <div class="pointer-events-none absolute -right-6 top-6 hidden aspect-[456/512] h-56 opacity-40 min-[420px]:block [mask-image:linear-gradient(to_left,black_60%,transparent)] lg:static lg:mx-auto lg:block lg:h-[52svh] lg:max-h-[520px] lg:min-h-[360px] lg:opacity-100 lg:[mask-image:none]">
      <div class="absolute left-1/2 top-1/2 hidden h-4/5 w-4/5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/15 blur-[100px] lg:block" aria-hidden="true"></div>
      <div class="hero-rig-shadow absolute bottom-1 left-0 right-0 mx-auto h-6 w-3/5 rounded-[100%] bg-black/55 blur-lg" aria-hidden="true"></div>
      <UbitRig loading="eager" />
    </div>
  </div>

  <a
    href="#diagnostico"
    class="hero-scroll-cue relative z-10 mx-auto inline-flex flex-col items-center gap-2 justify-self-center"
    aria-label="Ver exámenes especiales nuevos, más abajo"
  >
    <span class="hero-scroll-cue__badge relative rounded-full bg-primary px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
      <span class="hero-scroll-cue__ring" aria-hidden="true" />
      Nuevos · Exámenes especiales
    </span>
    <span class="hero-scroll-cue__chevrons" aria-hidden="true">
      <Icon name="keyboard_arrow_down" class="hero-scroll-cue__arrow hero-scroll-cue__arrow--1 text-3xl text-primary" filled />
      <Icon name="keyboard_arrow_down" class="hero-scroll-cue__arrow hero-scroll-cue__arrow--2 text-3xl text-primary" filled />
    </span>
  </a>
</section>

<style>
  .hero-scroll-cue {
    transition: transform 200ms cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hero-scroll-cue:hover,
  .hero-scroll-cue:focus-visible {
    transform: translateY(-2px);
  }

  .hero-scroll-cue__badge {
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-primary) 55%, transparent);
    animation: hero-scroll-cue-glow 2.2s ease-out infinite;
  }

  .hero-scroll-cue__ring {
    position: absolute;
    inset: -6px;
    border-radius: inherit;
    border: 1px solid color-mix(in srgb, var(--color-primary) 60%, transparent);
    animation: hero-scroll-cue-ring 2.2s ease-out infinite;
  }

  .hero-scroll-cue__chevrons {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 1.75rem;
  }

  .hero-scroll-cue__arrow {
    margin-top: -0.9rem;
    animation: hero-scroll-cue-float 1.4s ease-in-out infinite;
  }

  .hero-scroll-cue__arrow--1 {
    animation-delay: 0ms;
  }

  .hero-scroll-cue__arrow--2 {
    animation-delay: 200ms;
  }

  .hero-rig-shadow {
    animation: hero-rig-shadow 3.2s ease-in-out infinite;
  }

  @keyframes hero-rig-shadow {
    0%,
    100% {
      transform: scaleX(1);
      opacity: 0.55;
    }
    50% {
      transform: scaleX(0.9);
      opacity: 0.35;
    }
  }

  @keyframes hero-scroll-cue-glow {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-primary) 55%, transparent);
    }
    70% {
      box-shadow: 0 0 0 10px color-mix(in srgb, var(--color-primary) 0%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-primary) 0%, transparent);
    }
  }

  @keyframes hero-scroll-cue-ring {
    0% {
      opacity: 0.8;
      transform: scale(0.9);
    }
    100% {
      opacity: 0;
      transform: scale(1.25);
    }
  }

  @keyframes hero-scroll-cue-float {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    50% {
      transform: translateY(8px);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-cue__arrow,
    .hero-scroll-cue__badge,
    .hero-scroll-cue__ring,
    .hero-rig-shadow {
      animation: none;
      opacity: 1;
      box-shadow: none;
    }
  }
</style>
