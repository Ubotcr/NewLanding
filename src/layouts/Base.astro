---
import config from "@/config/config.json";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { canonicalUrl as resolveCanonical, serializeSchema, identitySchema, breadcrumbsSchema, type Breadcrumb, type StructuredData } from "@/lib/seo";
import Header from "./partials/Header.astro";
import Footer from "./partials/Footer.astro";

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  mascot?: boolean;
  ogType?: "website" | "article";
  structuredData?: StructuredData[];
  breadcrumbs?: Breadcrumb[];
}

const { title, meta_title, description, keywords, image, noindex, canonical, ogType = "website", mascot = false, structuredData = [], breadcrumbs = [] } =
  Astro.props;
const rawTitle = meta_title || title || config.site.title;
// Append the brand unless the title already carries it (or is the brand itself)
const pageTitle = rawTitle.toLowerCase().includes(config.site.title.toLowerCase())
  ? rawTitle
  : `${rawTitle} | ${config.site.title}`;
const pageDescription = description || config.metadata.meta_description;
const pageImage = image || config.metadata.meta_image;
const canonicalUrl = resolveCanonical(canonical || Astro.url.pathname);
if (!pageTitle.trim() || !pageDescription.trim()) throw new Error(`SEO incompleto: ${Astro.url.pathname}`);

import pkg from "../../package.json";
const v = pkg.version;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content={config.metadata.meta_author} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta
      property="og:url"
      content={canonicalUrl}
    />
    <meta property="og:image" content={`${config.site.base_url}${pageImage}?v=${v}`} />

    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${pageImage}?v=${v}`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href={`/favicon.png?v=${v}`} sizes="32x32" />
    <link rel="icon" type="image/png" href={`/icon-192.png?v=${v}`} sizes="192x192" />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${v}`} />
    <link rel="manifest" href={`/site.webmanifest?v=${v}`} />
    {mascot && <link rel="stylesheet" href={`/ubit-grad/ubit-grad.css?v=${v}`} />}
    <meta name="theme-color" content="#0f1117" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400..700,0..1,0&display=block"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400..700,0..1,0&display=block"
        rel="stylesheet"
      />
    </noscript>

    <Font cssVariable="--font-primary" preload />

    <script is:inline type="application/ld+json" set:html={serializeSchema(identitySchema)} />
    {breadcrumbs.length > 0 && <script is:inline type="application/ld+json" set:html={serializeSchema(breadcrumbsSchema(breadcrumbs))} />}
    {structuredData.map(data => <script is:inline type="application/ld+json" set:html={serializeSchema(data)} />)}
    {mascot && <script is:inline src="/ubit-grad/ubit-grad.js?v=1" defer></script>}
    <slot name="head" />
    <!-- GA4 con respeto DNT + consentimiento local. Si activas DNT o rechazas, no mide. -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-XHGSQZ25SH"
    ></script>
    <script is:inline>
      (function () {
        var dnt =
          navigator.doNotTrack === "1" ||
          window.doNotTrack === "1" ||
          navigator.msDoNotTrack === "1";
        var choice = null;
        try {
          choice = localStorage.getItem("ubot-consent");
        } catch (_) {}
        if (dnt || choice === "denied") return;
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", "G-XHGSQZ25SH", { anonymize_ip: true });
      })();
    </script>
    <!-- Google AdSense: verificación + revisión del sitio. Sin unidades de
      anuncio no renderiza nada visible hasta la aprobación. -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4694183941873770"
      crossorigin="anonymous"
    ></script>
  </head>
  <body class="bg-body text-text-light font-primary antialiased">
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <div
      id="ubot-consent"
      class="fixed inset-x-4 bottom-4 z-50 hidden rounded-xl border border-border bg-card p-4 shadow-lg"
      role="dialog"
      aria-live="polite"
      aria-label="Aviso de cookies"
    >
      <p class="text-sm text-text">
        Usamos cookies necesarias y analítica (GA4) para entender visitas.
        Si activamos anuncios, Google usará cookies publicitarias. Tú decides.
        Detalle en <a class="text-primary hover:underline" href="/privacy-policy">privacidad</a>.
      </p>
      <div class="mt-3 flex gap-2">
        <button
          type="button"
          data-consent="granted"
          class="btn btn-primary btn-sm"
        >
          Aceptar
        </button>
        <button
          type="button"
          data-consent="denied"
          class="btn btn-sm border border-border"
        >
          Rechazar
        </button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var key = "ubot-consent";
        var dnt =
          navigator.doNotTrack === "1" ||
          window.doNotTrack === "1" ||
          navigator.msDoNotTrack === "1";
        var choice = null;
        try {
          choice = localStorage.getItem(key);
        } catch (_) {}
        var banner = document.getElementById("ubot-consent");
        if (!banner || dnt || choice) return;
        banner.classList.remove("hidden");
        banner.querySelectorAll("[data-consent]").forEach(function (btn) {
          btn.addEventListener("click", function () {
            try {
              localStorage.setItem(key, btn.dataset.consent);
            } catch (_) {}
            banner.remove();
            if (btn.dataset.consent === "granted") location.reload();
          });
        });
      })();
    </script>
  </body>
</html>
