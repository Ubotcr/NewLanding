---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";
import OurTeam from "@/partials/OurTeam.astro";
import Icon from "@/components/Icon.astro";
import { getListPage } from "@/lib/contentParser";

const data = await getListPage("about/-index.md");
const { title, description, meta_title, page_header, who_we_are, our_team } =
  data.frontmatter;
const callToAction = await getListPage("sections/call-to-action.md");
---

<Base title={title} meta_title={meta_title} description={description}>
  <PageHeader page_header={page_header} />

  <section class="px-4 py-12 md:py-20">
    <div class="container mx-auto max-w-5xl">
      <div class="grid gap-12 md:grid-cols-2 md:items-center">
        <div>
          <h2 class="mt-3 text-2xl font-bold text-text-light md:text-3xl">
            {who_we_are.title}
          </h2>
          <p class="mt-4 text-text">{who_we_are.subtitle}</p>
        </div>

        <div class="flex flex-col gap-4">
          {
            [
              {
                icon: who_we_are.mission.icon,
                title: who_we_are.mission.title,
                content: who_we_are.mission.content,
              },
              {
                icon: who_we_are.problem.icon,
                title: who_we_are.problem.title,
                content: who_we_are.problem.content,
              },
              {
                icon: who_we_are.solution.icon,
                title: who_we_are.solution.title,
                content: who_we_are.solution.content,
              },
            ].map((item) => (
              <div class="flex items-start gap-4 rounded-xl border border-border bg-card p-4 shadow-sm">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-xl text-primary">
                  <Icon name={item.icon} class="text-[1.25rem]" />
                </span>
                <div>
                  <h3 class="font-semibold text-text-light">{item.title}</h3>
                  <p class="mt-1 text-sm text-text">{item.content}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <OurTeam data={our_team} />

  <section class="px-4 py-12 md:py-16" aria-labelledby="editorial-method">
    <div class="container content mx-auto max-w-3xl text-left">
      <h2 id="editorial-method">Cómo preparamos y corregimos el material</h2>
      <p>El equipo Ubot prepara guías y ejercicios para apoyar el estudio en Costa Rica. Los ejemplos propios se distinguen del material oficial. Ubot es independiente del MEP, la UCR, la UNA y el TEC; no otorga notas oficiales ni garantiza ingreso o resultados.</p>
      <h3>Fuentes y alcance</h3>
      <p>Para requisitos, fechas y formatos, usamos publicaciones de la institución responsable y enlazamos la fuente. Antes de un trámite, comprobá la convocatoria de tu año y tu cita individual. Los planes de estudio que proponemos son orientaciones adaptables, no métodos con resultados garantizados.</p>
      <h3>Autoría y revisión</h3>
      <p>Las guías identifican su autor y fecha de publicación. La fecha de actualización indica cambios sustanciales. Solo mostramos un nombre y fecha de revisión cuando esa revisión se haya realizado; no atribuimos formación docente ni aprobación institucional al equipo.</p>
      <p>Las seis prácticas públicas iniciales cuentan con revisión humana aprobada por el equipo Ubot. Su corrección automática compara respuestas con la solución preparada por Ubot: no sustituye esa revisión educativa. Consultá <a href="/admision/practica">Admisión</a> o <a href="/estandarizadas/practica">Matemáticas de Estandarizadas</a>.</p>
      <h3>Reportá un error</h3>
      <p>Escribinos a <a href="mailto:contacto@ubotcr.com">contacto@ubotcr.com</a> con el enlace, el número de pregunta o fragmento y una explicación del problema. Si tenés una fuente o una resolución alternativa, incluíla sin enviar datos personales de estudiantes. Evaluaremos el reporte y corregiremos el material cuando corresponda.</p>
      <p>Podés consultar las <a href="/blog">guías</a> y las <a href="/changelog">novedades del producto</a>. Las notas de versión describen cambios históricos; no aseguran que todas las funciones sigan disponibles de la misma forma.</p>
    </div>
  </section>

  <CallToAction data={callToAction} />
</Base>
