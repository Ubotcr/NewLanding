---
import PageHeader from "@/partials/PageHeader.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Base from "@/layouts/Base.astro";
import MathOverview from "@/partials/MathOverview.astro";
import PreparationClosing from "@/partials/PreparationClosing.astro";
import PracticeStrip from "@/partials/PracticeStrip.astro";
import FAQ from "@/partials/FAQ.astro";
import { estandarizadas, mathFaq } from "@/config/preparation";
---

<Base
  meta_title="Ubot Estandarizadas | Piloto de Matemáticas"
  description="Conoce el piloto de Matemáticas de Ubot para secundaria académica diurna: práctica por tema, tutor, examen diario y materiales según disponibilidad del catálogo."
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Ubot Estandarizadas",
        operatingSystem: "Web",
        applicationCategory: "EducationalApplication",
        url: estandarizadas.app,
        description: estandarizadas.description,
      })}
    />
  </Fragment>
  <PageHeader
    page_header={{
      title: "Prepara Matemáticas para las <mark>Estandarizadas</mark>",
      subtitle:
        "Conoce el nuevo piloto de Ubot para secundaria académica diurna: práctica por tema, tutor y materiales según el catálogo disponible.",
      button_primary: {
        enable: true,
        label: estandarizadas.entryLabel,
        link: estandarizadas.app,
      },
      button_secondary: {
        enable: true,
        label: "Cómo empezar",
        link: "#como-empezar",
      },
    }}
  />
  <section class="container mx-auto max-w-3xl px-4 py-10 content">
    <h2>Qué evalúa Matemáticas en las Pruebas Estandarizadas</h2>
    <p>
      Las Pruebas Nacionales Estandarizadas del MEP valoran la capacidad de
      interpretar modelos matemáticos, gráficas y problemas aplicados de
      secundaria. Según los lineamientos de la DGEC, la aplicación sumativa
      incluye 60 ítems en un bloque de 3 horas distribuidos en tres grandes
      áreas:
    </p>
    <ul>
      <li>
        <strong>Relaciones y Álgebra:</strong> pendiente de una recta, función
        lineal, función cuadrática, sistemas y proporcionalidad.
      </li>
      <li>
        <strong>Geometría:</strong> circunferencia en el plano cartesiano,
        traslaciones, polígonos y áreas.
      </li>
      <li>
        <strong>Estadística y Probabilidad:</strong> lectura de tablas y
        gráficos, medidas de tendencia central y probabilidad básica.
      </li>
    </ul>
    <h2>Guías y práctica abierta antes de usar la app</h2>
    <p>
      Podés repasar directamente en el sitio sin iniciar sesión:
    </p>
    <ul>
      <li><a href="/estandarizadas/matematicas">Centro de Matemáticas: 5 guías con ejemplos resueltos</a></li>
      <li><a href="/estandarizadas/practica">Ejercicios interactivos sin cuenta (pendiente, función lineal y porcentajes)</a></li>
      <li><a href="/blog/pruebas-nacionales-estandarizadas-mep-guia">Guía general de las Pruebas Nacionales Estandarizadas MEP</a></li>
      <li><a href="/blog/matematicas-estandarizadas-como-prepararse">Cómo organizar tu estudio de Matemáticas</a></li>
    </ul>
  </section>
  <MathOverview detailed />
  <section id="como-empezar" class="bg-card px-4 py-12 md:py-20">
    <div class="container mx-auto max-w-3xl">
      <SectionHeader
        title="Cómo empezar"
        subtitle="Consulta qué hay disponible y elegí una actividad para hoy."
      />
      <ol class="list-decimal space-y-6 pl-5 text-text">
        <li>
          <h3 class="text-lg font-semibold text-text-light">Inicia sesión</h3><p
            class="mt-2"
          >
            Entrá a la app de Estandarizadas para consultar el catálogo del
            piloto.
          </p>
        </li>
        <li>
          <h3 class="text-lg font-semibold text-text-light">
            Elige un tema o actividad
          </h3><p class="mt-2">
            Revisa los temas con preguntas, los materiales y las actividades
            habilitadas.
          </p>
        </li>
        <li>
          <h3 class="text-lg font-semibold text-text-light">
            Practica y revisa
          </h3><p class="mt-2">
            Resuelve una práctica, consulta su resultado o llevá una duda al
            tutor cuando esté disponible.
          </p>
        </li>
      </ol>
      <p class="mt-8 text-sm text-gray">
        Ubot ofrece preparación; sus prácticas no constituyen resultados
        oficiales del MEP.
      </p>
      <div class="mt-6 text-center">
        <a href={estandarizadas.app} class="btn btn-primary"
          >{estandarizadas.entryLabel}</a>
      </div>
    </div>
  </section>
  <FAQ data={mathFaq} />
  <PracticeStrip highlight="estandarizadas" />
  <PreparationClosing />
</Base>
