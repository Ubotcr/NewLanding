---
import { preparation } from "@/config/preparation";
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

{
  compact ? (
    <div class="flex flex-wrap items-center justify-center gap-4">
      {preparation.choices.map((choice, index) => (
        <a
          class:list={[
            "btn btn-lg",
            index === 0 ? "btn-primary" : "btn-outline",
          ]}
          href={choice.app}
        >
          {choice.entryLabel}
        </a>
      ))}
    </div>
  ) : (
    <div class="grid gap-6 md:grid-cols-2">
      {preparation.choices.map((choice, index) => (
        <article
          class="flex flex-col rounded-xl border border-border bg-card p-6 shadow-sm md:p-8"
          aria-labelledby={`choice-${choice.id}`}
        >
          <div class="flex flex-wrap items-center gap-3">
            <h3
              id={`choice-${choice.id}`}
              class="text-2xl font-bold text-text-light"
            >
              {choice.name}
            </h3>
            {index === 0 && (
              <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-link">
                Nuevo
              </span>
            )}
          </div>
          <p class="mt-4 text-text">{choice.description}</p>
          <div class="mt-auto flex flex-wrap items-center gap-5 pt-6">
            <a
              class:list={["btn", index === 0 ? "btn-primary" : "btn-outline"]}
              href={choice.app}
            >
              {choice.entryLabel}
            </a>
            <a
              href={choice.page}
              class="text-sm font-semibold text-link hover:underline"
            >
              Conocer más<span class="sr-only"> sobre {choice.name}</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  )
}
