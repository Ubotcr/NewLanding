---
import MathOverview from "@/partials/MathOverview.astro";
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import EssentialFeatures from "@/partials/EssentialFeatures.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { getListPage } from "@/lib/contentParser";

const data = await getListPage("features/-index.md");
const { title, description, meta_title, page_header } = data.frontmatter;
const essential_features = await getListPage("sections/essential-features.md");
const callToAction = await getListPage("sections/call-to-action.md");
---

<Base title={title} meta_title={meta_title} description={description}>
  <PageHeader page_header={page_header} />
  <MathOverview />
  <div class="container mx-auto max-w-5xl px-4 pt-8">
    <p class="text-text">Las siguientes herramientas corresponden a <strong>Ubot Admisión</strong>. <a href="/admision">Conocé la preparación para UCR, UNA y TEC →</a></p>
  </div>
  <EssentialFeatures data={essential_features} />
  <CallToAction data={callToAction} />
</Base>
