---
import Base from "@/layouts/Base.astro";
import Hero from "@/components/Hero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import MathOverview from "@/partials/MathOverview.astro";
import PreparationClosing from "@/partials/PreparationClosing.astro";
import FAQ from "@/partials/FAQ.astro";
import { admision, sharedFaq } from "@/config/preparation";
import { getListPage } from "@/lib/contentParser";
const {
  frontmatter: { banner },
} = await getListPage("homepage/-index.md");
---

<Base
  mascot
  meta_title="Ubot | Estandarizadas y Admisión en Costa Rica"
  description="Elegí tu preparación con Ubot: conocé el nuevo piloto de Matemáticas para Estandarizadas o seguí practicando para Admisión UCR, UNA y TEC."
>
  <Hero data={banner} showUniversities={false} choices />
  <MathOverview />
  <section class="bg-card px-4 py-12 md:py-20">
    <div class="container mx-auto max-w-5xl">
      <SectionHeader
        title="Seguí practicando con Admisión"
        subtitle="La temporada de admisión terminó. Las herramientas siguen disponibles para que practiqués a tu ritmo para UCR, UNA y TEC."
      />
      <ul class="mx-auto max-w-2xl list-disc space-y-3 pl-5 text-text">
        <li>
          Diagnóstico para reconocer tus fortalezas y lo que podés mejorar.
        </li>
        <li>Simulacros y práctica de razonamiento para UCR, UNA y TEC.</li>
        <li>Chat con IA, juegos e historial para seguir aprendiendo.</li>
      </ul>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={admision.page} class="btn btn-outline">Conocé Admisión</a>
        <a href={admision.app} class="btn btn-outline">{admision.entryLabel}</a>
      </div>
      <nav
        class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm"
        aria-label="Herramientas y planes de Admisión"
      >
        <a id="diagnostico" href="/admision#diagnostico"
          >Diagnóstico de Admisión</a
        >
        <a id="examen-especial" href="/admision#examen-especial"
          >Simulacros de Admisión</a
        >
        <a id="pricing" href="/pricing">Planes de Admisión</a>
        <a id="gallery" href="/admision#gallery">Ver Admisión por dentro</a>
      </nav>
    </div>
  </section>
  <FAQ data={sharedFaq} />
  <PreparationClosing />
<section class="container content mx-auto px-4 py-8"><h2>Practicá sin cuenta</h2><p>Resolvé ejercicios originales y consultá sus explicaciones.</p><a href="/admision/practica">Admisión</a> · <a href="/estandarizadas/practica">Matemáticas de Estandarizadas</a></section>
</Base>
