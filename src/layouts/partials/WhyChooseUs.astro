---
import SectionHeader from "@/components/SectionHeader.astro";
import Icon from "@/components/Icon.astro";

interface Props {
  data: any;
}

const { data } = Astro.props;
const { title, feature_list, enable } = data.frontmatter;
---

{
  enable && (
    <section class="border-y border-border bg-card px-4 py-14 md:py-20">
      <div class="container mx-auto max-w-5xl">
        <SectionHeader title={title} />

        <div class="grid gap-x-10 gap-y-8 border-t border-border pt-8 md:grid-cols-2">
          {feature_list.map((item: any) => (
            <div class="flex items-start gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-link">
                <Icon name={item.icon} class="text-xl" />
              </span>
              <div class="min-w-0">
                <h3 class="text-lg font-semibold text-text-light">
                  {item.title}
                </h3>
                <p class="mt-1.5 text-sm leading-relaxed text-text">
                  {item.content}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
