---
import Icon from "@/components/Icon.astro";

interface Props {
  highlight?: "admision" | "estandarizadas";
}

const { highlight } = Astro.props;

const links = [
  {
    key: "estandarizadas",
    label: "Matemáticas de Estandarizadas",
    href: "/estandarizadas/practica",
  },
  {
    key: "admision",
    label: "Admisión (UCR, UNA y TEC)",
    href: "/admision/practica",
  },
];

const orderedLinks =
  highlight === "admision" ? [links[1], links[0]] : links;
---

<section
  class="border-t border-border bg-ink-raised px-4 py-10 md:py-12"
  aria-labelledby="practice-strip-title"
>
  <div
    class="container mx-auto flex max-w-4xl flex-col items-start justify-between gap-6 md:flex-row md:items-center"
  >
    <div class="max-w-xl">
      <h2
        id="practice-strip-title"
        class="text-xl font-semibold text-text-light md:text-2xl"
      >
        Practica sin cuenta
      </h2>
      <p class="mt-1.5 text-sm leading-relaxed text-text md:text-base">
        Resolvé ejercicios originales y consultá sus explicaciones antes de registrarte.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      {
        orderedLinks.map((item) => (
          <a
            href={item.href}
            class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-semibold text-text-light no-underline transition-colors hover:border-link/60 hover:bg-body hover:no-underline"
          >
            <Icon name="quiz" class="text-base text-link" />
            <span>{item.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
